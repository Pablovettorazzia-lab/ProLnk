{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile document storing identity, subscription plan, and academic preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "User unique identifier matching auth UID" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100, "description": "User display name" },
        "email": { "type": "string", "format": "email", "maxLength": 200, "description": "User primary email address" },
        "photoURL": { "type": "string", "maxLength": 500, "description": "User profile photo URL" },
        "plan": { "type": "string", "maxLength": 60, "description": "Current subscription plan" },
        "role": { "type": "string", "enum": ["student", "tutor", "admin"], "description": "User system role" },
        "bio": { "type": "string", "maxLength": 500, "description": "Short student biography" },
        "university": { "type": "string", "maxLength": 150, "description": "Student school or university" },
        "major": { "type": "string", "maxLength": 150, "description": "Academic major or focus" },
        "semester": { "type": "string", "maxLength": 60, "description": "Current academic semester or grade" },
        "targetSubjects": { "type": "array", "description": "Bounded list of up to 20 target subjects" },
        "learningGoal": { "type": "string", "maxLength": 500, "description": "Student academic learning goal" },
        "streakDays": { "type": "number", "description": "Consecutive study streak in days" },
        "xpPoints": { "type": "number", "description": "Accumulated student experience points" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of account creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last profile update" }
      },
      "required": ["id", "name", "email", "plan", "role", "createdAt", "updatedAt"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Tutoring session booked by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Session ID" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Owner student user UID" },
        "expertId": { "type": "string", "maxLength": 128, "description": "Tutor identifier" },
        "expertName": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Tutor full name" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Academic subject" },
        "topic": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Specific topic or lesson focus" },
        "date": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Formatted date or schedule time" },
        "day": { "type": "string", "maxLength": 20, "description": "Day label" },
        "month": { "type": "string", "maxLength": 20, "description": "Month label" },
        "time": { "type": "string", "maxLength": 40, "description": "Scheduled time label" },
        "total": { "type": "number", "description": "Cost in Quetzales (Q)" },
        "status": { "type": "string", "enum": ["upcoming", "confirmed", "completed", "cancelled"], "description": "Session status" },
        "tutorNotes": { "type": "string", "maxLength": 1000, "description": "Notes and feedback provided by tutor" },
        "urgentUsed": { "type": "boolean", "description": "Whether priority urgent tutoring was applied" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["id", "userId", "expertName", "subject", "topic", "date", "status", "createdAt", "updatedAt"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Public community homework question and discussion thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Post unique ID" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Question summary title" },
        "previewText": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Detailed question content or preview" },
        "category": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Academic subject category" },
        "author": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Author display name" },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Author user UID" },
        "votes": { "type": "number", "description": "Number of community upvotes" },
        "repliesCount": { "type": "number", "description": "Number of replies" },
        "hasExpertAnswer": { "type": "boolean", "description": "Whether an expert verified this" },
        "expertName": { "type": "string", "maxLength": 100, "description": "Name of answering expert" },
        "expertAnswer": { "type": "string", "maxLength": 3000, "description": "Expert verified solution" },
        "timeAgo": { "type": "string", "maxLength": 40, "description": "Human readable time ago string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["id", "title", "previewText", "category", "author", "authorId", "votes", "repliesCount", "hasExpertAnswer", "createdAt", "updatedAt"]
    },
    "UserSketch": {
      "title": "UserSketch",
      "description": "User saved whiteboard note or scratchpad diagram",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Sketch ID" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Owner user UID" },
        "title": { "type": "string", "minLength": 1, "maxLength": 150, "description": "Title of the sketch" },
        "dataUrl": { "type": "string", "maxLength": 500000, "description": "Serialized sketch payload or bounded data URI" },
        "timestamp": { "type": "string", "maxLength": 60, "description": "Human readable timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["id", "userId", "title", "dataUrl", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and account details"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "User private scheduled and completed tutoring sessions"
    },
    "/users/{userId}/sketches/{sketchId}": {
      "schema": "UserSketch",
      "description": "User private whiteboard drawings and notes"
    },
    "/forum_posts/{postId}": {
      "schema": "ForumPost",
      "description": "Public community forum questions and expert answers"
    }
  }
}
