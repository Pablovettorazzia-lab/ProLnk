rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key, minVal, maxVal) {
      return !(key in data) || (data[key] is number && data[key] >= minVal && data[key] <= maxVal);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    // Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'plan', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'email', 'photoURL', 'plan', 'role',
          'bio', 'university', 'major', 'semester', 'targetSubjects',
          'learningGoal', 'streakDays', 'xpPoints', 'questionsResolved',
          'tutoringMinutes', 'notesSavedCount', 'forumPostsCount',
          'lastActiveDate', 'aiExplanationStyle', 'emailNotifications',
          'sessionReminders', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.plan is string && data.plan.size() >= 1 && data.plan.size() <= 60
        && data.role is string && data.role in ['student', 'tutor', 'admin']
        && isOptionalString(data, 'photoURL', 500)
        && isOptionalString(data, 'bio', 500)
        && isOptionalString(data, 'university', 150)
        && isOptionalString(data, 'major', 150)
        && isOptionalString(data, 'semester', 60)
        && isOptionalString(data, 'learningGoal', 500)
        && isOptionalNumber(data, 'streakDays', 0, 100000)
        && isOptionalNumber(data, 'xpPoints', 0, 10000000)
        && isOptionalNumber(data, 'questionsResolved', 0, 1000000)
        && isOptionalNumber(data, 'tutoringMinutes', 0, 1000000)
        && isOptionalNumber(data, 'notesSavedCount', 0, 100000)
        && isOptionalNumber(data, 'forumPostsCount', 0, 100000)
        && isOptionalString(data, 'lastActiveDate', 40)
        && (!('aiExplanationStyle' in data) || (data.aiExplanationStyle is string && data.aiExplanationStyle in ['detailed', 'quick']))
        && isOptionalBool(data, 'emailNotifications')
        && isOptionalBool(data, 'sessionReminders')
        && (!('targetSubjects' in data) || (
          data.targetSubjects is list
          && data.targetSubjects.size() <= 20
          && (data.targetSubjects.size() == 0 || (data.targetSubjects[0] is string && data.targetSubjects[0].size() <= 80))
        ))
        && (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40))
        && data.updatedAt is timestamp;
    }

    function isValidUserSession(data) {
      return data.keys().hasAll(['id', 'userId', 'expertName', 'subject', 'topic', 'date', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'expertId', 'expertName', 'subject', 'topic',
          'date', 'day', 'month', 'time', 'total', 'status',
          'tutorNotes', 'urgentUsed', 'meetUri', 'meetCode', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && isOptionalString(data, 'expertId', 128)
        && data.expertName is string && data.expertName.size() >= 1 && data.expertName.size() <= 100
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 80
        && isOptionalString(data, 'day', 20)
        && isOptionalString(data, 'month', 20)
        && isOptionalString(data, 'time', 40)
        && isOptionalNumber(data, 'total', 0, 100000)
        && data.status is string && data.status in ['upcoming', 'confirmed', 'completed', 'cancelled']
        && isOptionalString(data, 'tutorNotes', 1000)
        && isOptionalBool(data, 'urgentUsed')
        && isOptionalString(data, 'meetUri', 300)
        && isOptionalString(data, 'meetCode', 60)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'subject', 'dueDate', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'title', 'subject', 'dueDate', 'completed', 'urgency', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80
        && data.dueDate is string && data.dueDate.size() >= 1 && data.dueDate.size() <= 80
        && data.completed is bool
        && (!('urgency' in data) || (data.urgency is string && data.urgency in ['high', 'medium', 'low']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSketch(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'dataUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'dataUrl', 'timestamp', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.dataUrl is string && data.dataUrl.size() >= 1 && data.dataUrl.size() <= 500000
        && isOptionalString(data, 'timestamp', 60)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiChatThread(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'title', 'previewText', 'messageCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && isOptionalString(data, 'previewText', 300)
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'chatId', 'sender', 'text', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'chatId', 'sender', 'text', 'isError',
          'attachedFileNames', 'sources', 'searchQueries', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.chatId)
        && data.sender is string && data.sender in ['user', 'ai']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 12000
        && isOptionalBool(data, 'isError')
        && (!('attachedFileNames' in data) || (
          data.attachedFileNames is list
          && data.attachedFileNames.size() <= 5
          && (data.attachedFileNames.size() == 0 || (data.attachedFileNames[0] is string && data.attachedFileNames[0].size() <= 150))
        ))
        && (!('sources' in data) || (
          data.sources is list
          && data.sources.size() <= 8
          && (data.sources.size() == 0 || (data.sources[0] is map && data.sources[0].title is string && data.sources[0].title.size() <= 200))
        ))
        && (!('searchQueries' in data) || (
          data.searchQueries is list
          && data.searchQueries.size() <= 8
          && (data.searchQueries.size() == 0 || (data.searchQueries[0] is string && data.searchQueries[0].size() <= 200))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidForumPost(data) {
      return data.keys().hasAll([
          'id', 'title', 'previewText', 'category', 'author',
          'authorId', 'votes', 'repliesCount', 'hasExpertAnswer', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'previewText', 'category', 'author', 'authorId',
          'votes', 'repliesCount', 'hasExpertAnswer', 'expertName',
          'expertAnswer', 'timeAgo', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.previewText is string && data.previewText.size() >= 1 && data.previewText.size() <= 2000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 100
        && isValidId(data.authorId)
        && data.votes is int && data.votes >= 0 && data.votes <= 1000000
        && data.repliesCount is int && data.repliesCount >= 0 && data.repliesCount <= 100000
        && data.hasExpertAnswer is bool
        && isOptionalString(data, 'expertName', 100)
        && isOptionalString(data, 'expertAnswer', 3000)
        && isOptionalString(data, 'timeAgo', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidForumComment(data) {
      return data.keys().hasAll([
          'id', 'postId', 'authorId', 'author', 'avatarInitials', 'text', 'upvotes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'postId', 'authorId', 'author', 'authorRole', 'avatarInitials',
          'text', 'upvotes', 'timeLabel', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.postId)
        && isValidId(data.authorId)
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 100
        && (!('authorRole' in data) || (data.authorRole is string && data.authorRole in ['student', 'expert']))
        && data.avatarInitials is string && data.avatarInitials.size() >= 1 && data.avatarInitials.size() <= 10
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.upvotes is int && data.upvotes >= 0 && data.upvotes <= 100000
        && isOptionalString(data, 'timeLabel', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection check document (read-only single doc get, writes strictly denied)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, write: if false;
    }

    // User profiles & private subcollections (PII isolated to owner only)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == userId
        && incoming().role == 'student'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && incoming().role == existing().role
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'photoURL', 'plan', 'bio', 'university', 'major',
          'semester', 'targetSubjects', 'learningGoal', 'streakDays',
          'xpPoints', 'questionsResolved', 'tutoringMinutes',
          'notesSavedCount', 'forumPostsCount', 'lastActiveDate',
          'aiExplanationStyle', 'emailNotifications', 'sessionReminders',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private tutoring sessions (Master Gate enforces existing parent user profile)
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidUserSession(incoming())
          && incoming().id == sessionId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidUserSession(incoming())
          && !(existing().status in ['completed', 'cancelled'])
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'topic', 'date', 'day', 'month', 'time', 'status',
            'tutorNotes', 'urgentUsed', 'meetUri', 'meetCode', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }

      // Private assignment tasks (Master Gate enforces existing parent user profile)
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && isValidUserTask(incoming())
          && incoming().id == taskId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && isValidUserTask(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'subject', 'dueDate', 'completed', 'urgency', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      }

      // Private whiteboard sketches (Master Gate enforces existing parent user profile)
      match /sketches/{sketchId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sketchId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sketchId)
          && isValidUserSketch(incoming())
          && incoming().id == sketchId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sketchId)
          && isValidUserSketch(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'dataUrl', 'timestamp', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sketchId);
      }

      // Private AI Tutor conversation threads (Master Gate enforces existing parent user profile)
      match /ai_chats/{chatId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(chatId)
          && isValidAiChatThread(incoming())
          && incoming().id == chatId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(chatId)
          && isValidAiChatThread(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'previewText', 'messageCount', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chatId);

        // Messages inside a user's AI Tutor thread
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(chatId) && isValidId(messageId);
          allow list: if isOwner(userId) && existing().userId == request.auth.uid && existing().chatId == chatId;
          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(chatId)
            && isValidId(messageId)
            && isValidAiChatMessage(incoming())
            && incoming().id == messageId
            && incoming().userId == userId
            && incoming().chatId == chatId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/ai_chats/$(chatId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)/ai_chats/$(chatId))
            );
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chatId) && isValidId(messageId);
        }
      }
    }

    // Public community forum posts with strict author, reply counter, and upvote validation
    match /forum_posts/{postId} {
      allow get: if isValidId(postId);
      allow list: if existing().createdAt > timestamp.date(1970, 1, 1)
        && request.query.limit <= 100;
      allow create: if isSignedIn()
        && isValidId(postId)
        && isValidForumPost(incoming())
        && incoming().id == postId
        && incoming().authorId == request.auth.uid
        && incoming().votes == 1
        && incoming().repliesCount == 0
        && incoming().hasExpertAnswer == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(postId)
        && isValidForumPost(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Author edits post content
          (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'previewText', 'category', 'updatedAt'])
          )
          ||
          // Action 2: Authenticated community upvote/unvote (+/- 1)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'updatedAt'])
            && (incoming().votes == existing().votes + 1 || incoming().votes == existing().votes - 1)
          )
          ||
          // Action 3: Authenticated reply counter increment (+1) when posting a comment
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount', 'updatedAt'])
            && incoming().repliesCount == existing().repliesCount + 1
          )
        );
      allow delete: if isSignedIn()
        && isValidId(postId)
        && existing().authorId == request.auth.uid;

      // Community comments / replies inside a forum question
      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId);
        allow list: if isValidId(postId)
          && existing().createdAt > timestamp.date(1970, 1, 1)
          && request.query.limit <= 100;
        allow create: if isSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidForumComment(incoming())
          && incoming().id == commentId
          && incoming().postId == postId
          && incoming().authorId == request.auth.uid
          && incoming().upvotes == 1
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/forum_posts/$(postId))
            || existsAfter(/databases/$(database)/documents/forum_posts/$(postId))
          );
        allow update: if isSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidForumComment(incoming())
          && incoming().id == existing().id
          && incoming().postId == existing().postId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action 1: Comment author edits text
            (
              existing().authorId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])
            )
            ||
            // Action 2: Authenticated upvote/unvote (+/- 1)
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'updatedAt'])
              && (incoming().upvotes == existing().upvotes + 1 || incoming().upvotes == existing().upvotes - 1)
            )
          );
        allow delete: if isSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && existing().authorId == request.auth.uid;
      }
    }
  }
}
